# Todas as variáveis são exclusivas do servidor. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Identificador interno da conta. O formulário público solicita somente a senha.
ADMIN_AUTH_EMAIL=
APP_ORIGIN=http://127.0.0.1:3000
# Número do site original. Confirme com a proprietária antes de publicar.
WHATSAPP_NUMBER=557999226515
# Catálogo de demonstração apenas em desenvolvimento. Não dispensa autenticação do admin.
DEMO_MODE=true
# Ative apenas atrás de proxy que SUBSTITUI x-forwarded-for. O padrão ignora esse header.
TRUST_PROXY_HEADERS=false

# Melhor Envio: utilize uma das duas variáveis de token, exclusivamente no servidor.
MELHOR_ENVIO_TOKEN=
# Alias compatível com a configuração existente.
token_melhorenvio=
MELHOR_ENVIO_ENVIRONMENT=sandbox
# Email real de contato técnico exigido pelo Melhor Envio.
SHIPPING_CONTACT_EMAIL=
# Opcional, segredo do aplicativo para assinatura de webhooks. Não é o token acima.
MELHOR_ENVIO_WEBHOOK_SECRET=
# Opcional, IDs de serviços separados por vírgula.
MELHOR_ENVIO_SERVICES=
# Dados privados do remetente. Preencha no servidor, nunca no código público.
SHIPPING_ORIGIN_POSTAL_CODE=
SHIPPING_ORIGIN_ADDRESS=
SHIPPING_ORIGIN_NUMBER=
SHIPPING_ORIGIN_COMPLEMENT=
SHIPPING_ORIGIN_DISTRICT=
SHIPPING_ORIGIN_CITY=
SHIPPING_ORIGIN_STATE=
# Nome, email, documento e telefone são consultados no perfil autenticado.
# Estes campos opcionais permitem usar os dados fiscais da loja.
SHIPPING_SENDER_NAME=
SHIPPING_SENDER_EMAIL=
SHIPPING_SENDER_PHONE=
SHIPPING_SENDER_DOCUMENT=
SHIPPING_SENDER_COMPANY_DOCUMENT=
SHIPPING_SENDER_STATE_REGISTER=
# Uma caixa por pedido, conforme a embalagem confirmada pelo lojista.
SHIPPING_PACKING_MODE=per_order
SHIPPING_PACKAGE_WEIGHT_KG=0.3
SHIPPING_PACKAGE_HEIGHT_CM=12
SHIPPING_PACKAGE_WIDTH_CM=32
SHIPPING_PACKAGE_LENGTH_CM=27
# Capacidade opcional. Em branco, segue uma caixa por pedido.
SHIPPING_PACKAGE_MAX_ITEMS=
# Ative apenas após confirmar que a declaração é permitida para a operação.
SHIPPING_DECLARATION_AUTHORIZED=false

# Pix VeloraPay. As chaves, incluindo a pública, ficam somente no servidor.
VELORA_PUBLIC_KEY=
VELORA_SECRET_KEY=
# Aliases aceitos para a configuração existente.
velora_publickey=
velora_secretkey=
# Copie o segredo gerado pelo painel de webhooks da VeloraPay.
VELORA_WEBHOOK_SECRET=
VELORA_WEBHOOK_URL=https://www.recursosdatiacris.com.br/api/webhooks/velora
VELORA_MODE=production
# Agendador do Supabase. Gere 32 bytes aleatórios em hexadecimal (64 caracteres).
CRON_SECRET=
# Frete grátis na opção econômica, com diferença nas demais modalidades.
FREE_SHIPPING_ALL_SERVICES=false
# Habilite após configurar SMTP, confirmação de email e provedores no Supabase.
CUSTOMER_AUTH_ENABLED=false
CUSTOMER_GOOGLE_AUTH_ENABLED=false
CUSTOMER_APPLE_AUTH_ENABLED=false
